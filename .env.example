# Almena Status configuration. `task init` copies this file to .env, which
# Next.js, Docker Compose and Task all read.

# Port published on the host by Docker Compose (the page listens on 3000 inside).
STATUS_WEB_PORT=3200

# Public origin of the status page (canonical URL and other metadata).
# Inlined into the bundle when building: rebuild (`task up`) after changing it.
NEXT_PUBLIC_STATUS_WEB_URL=https://status.almena.id

# Seconds between two rounds of probes, how long a probe may take (ms) and
# from how many ms an answer counts as slow (degraded).
STATUS_PROBE_INTERVAL_SECONDS=60
STATUS_PROBE_TIMEOUT_MS=10000
STATUS_SLOW_MS=2000

# Where the watched resources, the incidents and the probes' history (SQLite)
# are, for `task dev`. Docker sets its own (the mounted resources.json and
# ./incidents, the /data volume).
# STATUS_RESOURCES_FILE=./resources.json
# STATUS_INCIDENTS_DIR=./incidents
# STATUS_DATA_DIR=./data
